# Copy to .env and fill in. Never commit .env.
PORT=3001

# Shown at the top of the employee and admin pages.
BUSINESS_NAME=ShiftCheck

DB_HOST=localhost
DB_PORT=3306
DB_NAME=shiftcheck
DB_USER=shiftcheck
DB_PASS=

# 32+ random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Only if the app runs behind a reverse proxy (nginx, Caddy, a load balancer) that sets X-Forwarded-For.
TRUST_PROXY=false

# Look up a city for each sign-in IP through ipapi.co (sends the employee's IP address to that service).
GEO_LOOKUP=false

# Only if the admin console is served from a different origin than the API. Leave empty normally.
CORS_ORIGIN=
